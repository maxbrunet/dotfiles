From b4f150c9747f2152fe1431e95e583accd2c20ff7 Mon Sep 17 00:00:00 2001
From: AILIFE <ailife8881@gmail.com>
Date: Mon, 19 Oct 2026 09:52:38 +0800
Subject: [PATCH 2/2] fix(session): keep pickers and project auto-accept

A pending prompt no longer hides an explicitly opened picker. Unloaded
sessions go through consider() so a project auto-accept override still applies.
---
 packages/app/src/session/requests/auto-approve.ts | 12 +++++++-----
 packages/tui/src/routes/session/index.tsx         |  8 ++++----
 2 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/packages/app/src/session/requests/auto-approve.ts b/packages/app/src/session/requests/auto-approve.ts
index 885984b922..36d2c27fda 100644
--- a/packages/app/src/session/requests/auto-approve.ts
+++ b/packages/app/src/session/requests/auto-approve.ts
@@ -48,13 +48,15 @@ export function createPermissionAutoApprover(input: { sdk: ServerSDK; data: Data
 
     // session.list() misses a subagent whose permissions were synced before its info landed.
     // Those requests are otherwise invisible while auto-approve hides the dock.
-    const ids = new Set([
-      ...input.data.session.list().map((session) => session.id),
-      ...input.data.session.permission.sessions(),
-    ])
-    for (const id of ids) {
+    // Unknown sessions must go through consider() so a project override is not skipped.
+    const listed = new Set(input.data.session.list().map((session) => session.id))
+    for (const id of listed) {
       for (const request of input.data.session.permission.list(id) ?? []) approve(request)
     }
+    for (const id of input.data.session.permission.sessions()) {
+      if (listed.has(id)) continue
+      for (const request of input.data.session.permission.list(id) ?? []) consider(request)
+    }
   })
 
   // An incomplete sweep leaves pending requests hidden with no later trigger
