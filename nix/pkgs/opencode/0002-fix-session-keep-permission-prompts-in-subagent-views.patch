 packages/app/src/session/requests/model.ts    |  7 ++--
 packages/tui/src/routes/session/index.tsx     | 36 +++++++++++++------
 packages/tui/src/util/session.ts              | 24 +++++++++++++
 packages/tui/test/util/session.test.ts        | 19 +++++++++-
 6 files changed, 82 insertions(+), 17 deletions(-)

