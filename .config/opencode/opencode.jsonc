{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": false }, // Replaced by Magic Context
  "model": "cohere/north-mini-code-1-0",
  "formatter": {
    "d2": {
      "command": ["d2", "fmt", "$FILE"],
      "extensions": [".d2"],
    },
    "gofmt": {},
    "jsonnetfmt": {
      "command": ["jsonnetfmt", "--in-place", "$FILE"],
      "extensions": [".jsonnet", ".libsonnet"],
    },
    "nixfmt": {},
    "rustfmt": {},
    "terraform": {},
  },
  "lsp": {
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"],
      "initialization": {
        "bashIde": {
          "shfmt": {
            // Google-style
            "binaryNextLine": true,
            "caseIndent": true,
          },
        },
      },
    },
    "buf": {
      "command": ["buf", "lsp", "serve", "--log-format=text"],
      "extensions": [".proto"],
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"],
    },
    "docker": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": ["Dockerfile"],
    },
    "golangci-lint": {
      "command": ["golangci-lint-langserver"],
      "extensions": [".go"],
      "initialization": {
        "command": [
          "golangci-lint",
          "run",
          // disable all output formats that might be enabled by the users .golangci.yml
          "--output.text.path=",
          "--output.tab.path=",
          "--output.html.path=",
          "--output.checkstyle.path=",
          "--output.junit-xml.path=",
          "--output.teamcity.path=",
          "--output.sarif.path=",
          // disable stats output
          "--show-stats=false",
          // enable JSON output to be used by the language server
          "--output.json.path=stdout",
        ],
      },
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html"],
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"],
    },
    "jsonnet": {
      "command": ["jsonnet-language-server"],
      "extensions": [".jsonnet", ".libsonnet"],
    },
    "marksman": {
      "command": ["marksman", "server"],
      "extensions": [".md", ".mdx"],
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"],
    },
    "tflint": {
      "command": ["tflint", "--langserver"],
      "extensions": [".tf"],
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"],
    },
  },
  "mcp": {
    "servers": {
      "gopls": {
        "type": "local",
        "command": ["gopls", "mcp"],
        "cwd": ".",
        "disabled": false,
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:TAVILY_API_KEY}",
        },
        "disabled": false,
      },
      "rea": {
        "type": "local",
        "command": ["rea", "mcp"],
        "disabled": true,
      },
    },
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "gopls_go_diagnostics", "resource": "*", "effect": "allow" },
    { "action": "gopls_go_file_context", "resource": "*", "effect": "allow" },
    { "action": "gopls_go_package_api", "resource": "*", "effect": "allow" },
    { "action": "gopls_go_search", "resource": "*", "effect": "allow" },
    {
      "action": "gopls_go_symbol_references",
      "resource": "*",
      "effect": "allow",
    },
    { "action": "gopls_go_vulncheck", "resource": "*", "effect": "allow" },
    { "action": "gopls_go_workspace", "resource": "*", "effect": "allow" },
    { "action": "tavily_tavily_extract", "resource": "*", "effect": "allow" },
    { "action": "tavily_tavily_search", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ast-grep outline *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
  ],
  "plugins": ["./packages/@cortexkit/opencode-magic-context"],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "cohere", "effect": "allow" },
  ],
  "providers": {
    "cohere": {
      "name": "Cohere",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.cohere.com/compatibility/v1",
        "apiKey": "{env:CO_API_KEY}",
      },
      "models": {
        "command-a-03-2025": {
          "name": "Command A 03-2025",
          "cost": { "input": 2.5, "output": 10 },
          "limit": { "context": 256000, "output": 8000 },
        },
        "command-a-plus-05-2026": {
          "name": "Command A+ 05-2026",
          // Free until rate limits are reached (20 req/min)
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 128000, "output": 64000 },
        },
        "command-a-reasoning-08-2025": {
          "name": "Command A Reasoning 08-2025",
          // Free until rate limits are reached (20 req/min)
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 256000, "output": 32000 },
        },
        "command-r7b-12-2024": {
          "name": "Command R7B 12-2024",
          "capabilities": { "reasoning": { "supported": false } },
          "cost": { "input": 0.0375, "output": 0.15 },
          "limit": { "context": 128000, "output": 4000 },
        },
        "command-r-08-2024": {
          "name": "Command R 08-2024",
          "capabilities": { "reasoning": { "supported": false } },
          "cost": { "input": 0.15, "output": 0.6 },
          "limit": { "context": 128000, "output": 4000 },
        },
        "command-r-plus-08-2024": {
          "name": "Command R+ 08-2024",
          "capabilities": { "reasoning": { "supported": false } },
          "cost": { "input": 2.5, "output": 10 },
          "limit": { "context": 128000, "output": 4000 },
        },
        "north-mini-code-1-0": {
          "name": "North Mini Code",
          // Free until rate limits are reached (20 req/min)
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 256000, "output": 64000 },
        },
      },
    },
  },
  "update": "disable",
  "websearch": { "provider": "tavily" },
}
